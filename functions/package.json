{
  "name": "functions",
  "scripts": {
    "lint": "eslint .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && npx firebase-tools@15.11.0 emulators:start --only functions --config ../firebase.json",
    "serve:functions": "npm run serve",
    "shell": "npm run build && npx firebase-tools@15.11.0 functions:shell --config ../firebase.json",
    "start": "npm run shell",
    "deploy": "npx firebase-tools@15.11.0 deploy --only functions --config ../firebase.json",
    "logs": "npx firebase-tools@15.11.0 functions:log --config ../firebase.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.12.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.2",
    "validator": "^13.15.23"
  },
  "devDependencies": {
    "@ljharb/tsconfig": "^0.3.2",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "firebase-tools": "15.11.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.3"
  },
  "private": true
}
