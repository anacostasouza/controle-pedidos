{
  "functions": [
    {
      "source": "functions",
      "runtime": "nodejs22",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 9000,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4101
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4402
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4502
    },
    "eventarc": {
      "host": "127.0.0.1",
      "port": 9301
    },
    "tasks": {
      "host": "127.0.0.1",
      "port": 9501
    },
    "singleProjectMode": true
  }
}
