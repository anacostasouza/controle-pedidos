{
  "name": "financeiro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5176",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host localhost",
    "deploy:hosting": "npm run build && npx firebase-tools@15.11.0 deploy --only hosting --config ../firebase.financeiro.json --project gestaopedidos-desenhar",
    "deploy": "npm run deploy:hosting"
  },
  "dependencies": {
    "firebase": "11.10.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.8.3",
    "vite": "7.3.3"
  }
}
